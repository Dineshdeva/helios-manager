# Helios Manager BFF — Environment Variables
# Copy to .env and fill in your values

# BFF server port
PORT=3001

# Helios (Settings Vault) base URL
HELIOS_BASE_URL=https://api.guidewire.com

# Okta token endpoint for Guidewire Hub
HELIOS_TOKEN_URL=https://guidewire-hub.okta.com/oauth2/default/v1/token

# OAuth2 client credentials (never commit real values)
HELIOS_CLIENT_ID=your-client-id-here
HELIOS_CLIENT_SECRET=your-client-secret-here

# Space-separated list of scopes required by Helios
HELIOS_SCOPES=groups tenant_id

# Allowed origin for CORS (React dev server)
FRONTEND_URL=http://localhost:3000
