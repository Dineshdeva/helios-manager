# Helios Manager BFF — Environment Variables
# Copy to .env and fill in your values

# BFF server port
PORT=3001

# Helios (Settings Vault) base URL
HELIOS_BASE_URL=https://api.guidewire.com

# Okta token endpoint for Guidewire Hub
HELIOS_TOKEN_URL=https://guidewire-hub.okta.com/oauth2/default/v1/token

# OAuth2 client credentials (never commit real values)
HELIOS_CLIENT_ID=your-client-id-here
HELIOS_CLIENT_SECRET=your-client-secret-here

# Space-separated list of scopes required by Helios
HELIOS_SCOPES=groups tenant_id

# Allowed origin for CORS — set to the deployed frontend URL in production
# Development:  FRONTEND_URL=http://localhost:3000
# Production:   FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# ── OAuth2 Authorization Code + PKCE (interactive login — recommended) ────────
# The client_id visible in the Helios Swagger UI "Authorize" dialog.
# Development:  register http://localhost:3001/bff/auth/callback as a redirect URI.
# Production:   register https://your-backend.onrender.com/bff/auth/callback.
HELIOS_CLIENT_ID=your-client-id-here
HELIOS_REDIRECT_URI=http://localhost:3001/bff/auth/callback

# ── Client credentials (headless / CI fallback — optional) ───────────────────
# Set HELIOS_CLIENT_SECRET only if you want the service-account fallback.
# Leave blank when using interactive login above.
HELIOS_CLIENT_SECRET=

# ── Session ───────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Set to true when running behind a TLS-terminating reverse proxy in production
# (NODE_ENV alone is insufficient when the proxy forwards HTTP internally).
# Always set COOKIE_SECURE=true in production deployments (Render, Railway, etc.)
COOKIE_SECURE=false

# ── Write operations (disabled by default) ───────────────────────────────────
# Set to true to allow POST/PUT through the BFF. A confirmation step is still
# enforced in the UI, and every mutation is audit-logged.
ENABLE_WRITE_OPS=false
